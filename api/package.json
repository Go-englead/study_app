{
  "name": "study-app-api",
  "version": "1.0.0",
  "description": "study_app API サーバー（Hono / @hono/node-server）。",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch index.ts",
    "start": "tsx index.ts",
    "test": "TESTCONTAINERS_RYUK_DISABLED=true vitest run",
    "test:watch": "TESTCONTAINERS_RYUK_DISABLED=true vitest",
    "db:generate": "drizzle-kit generate",
    "openapi:gen": "openapi-typescript openapi.yaml -o generated/openapi.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@node-rs/argon2": "2.0.2",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.6.14",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.0.2",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.31.10",
    "openapi-typescript": "^7.13.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.2.6"
  }
}
